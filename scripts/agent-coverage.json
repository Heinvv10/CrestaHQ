{
  "trees": {
    "api/admin": {
      "exclude": {
        "category": "human-only",
        "reason": "Platform-operator console for the template seller (instance fleet, buyer reminder blast); no sub-account data and no agency key reaches it."
      }
    },
    "api/affiliate": {
      "exclude": {
        "category": "human-only",
        "reason": "The affiliate portal's own login, logout and payout settings; an affiliate's session, not an agency's."
      }
    },
    "api/agency": {
      "scope": true
    },
    "api/agents": {
      "exclude": {
        "category": "internal",
        "reason": "QStash-signed watchdog sweep worker; no caller but the queue."
      }
    },
    "api/ai-suite": {
      "exclude": {
        "category": "chat-only",
        "reason": "The in-app AI Suite chat transport itself (chat, confirm, thread, usage); agents use /api/mcp and /api/v1/tools."
      }
    },
    "api/auth": {
      "exclude": {
        "category": "human-only",
        "reason": "Signup, password reset and session claim refresh for a signed-in person."
      }
    },
    "api/automations": {
      "scope": true
    },
    "api/booking": {
      "exclude": {
        "category": "public-unauth",
        "reason": "Public booking-page availability and booking for visitors, with no session."
      }
    },
    "api/broadcasts": {
      "scope": true
    },
    "api/checkout": {
      "exclude": {
        "category": "public-unauth",
        "reason": "The marketing site's founders checkout for template buyers."
      }
    },
    "api/co": {
      "exclude": {
        "category": "public-unauth",
        "reason": "A visitor's checkout-page session on a published checkout page."
      }
    },
    "api/comms": {
      "scope": true
    },
    "api/community": {
      "scope": true
    },
    "api/companies": {
      "scope": true
    },
    "api/contacts": {
      "scope": true
    },
    "api/cron": {
      "exclude": {
        "category": "internal",
        "reason": "Scheduled jobs authenticated by the cron / QStash signature; no caller but the scheduler."
      }
    },
    "api/deals": {
      "scope": true
    },
    "api/dev-only": {
      "exclude": {
        "category": "internal",
        "reason": "Development-only seed and wipe routes, refused in production."
      }
    },
    "api/events": {
      "scope": true
    },
    "api/forms": {
      "scope": true
    },
    "api/github": {
      "exclude": {
        "category": "internal",
        "reason": "A disabled stub that answers 410 to every call."
      }
    },
    "api/gitpage-reminder": {
      "exclude": {
        "category": "internal",
        "reason": "QStash-signed step worker of the operator's Gitpage reminder blast."
      }
    },
    "api/google": {
      "exclude": {
        "category": "human-only",
        "reason": "Google OAuth callback; completing a consent screen is a person's act."
      }
    },
    "api/import": {
      "exclude": {
        "category": "internal",
        "reason": "QStash-signed step worker of the GHL import; the import itself starts under api/sub-accounts."
      }
    },
    "api/landing": {
      "exclude": {
        "category": "public-unauth",
        "reason": "The marketing landing page's heartbeat, metrics and recent-purchase ticker."
      }
    },
    "api/mcp": {
      "exclude": {
        "category": "internal",
        "reason": "The agent MCP transport itself; it is how tools are reached, not a route a tool wraps."
      }
    },
    "api/meta": {
      "exclude": {
        "category": "human-only",
        "reason": "Meta OAuth callback; completing a consent screen is a person's act."
      }
    },
    "api/public": {
      "exclude": {
        "category": "public-unauth",
        "reason": "Public, unauthenticated feeds and share links (GBP feed, shared report, snapshot share)."
      }
    },
    "api/push": {
      "exclude": {
        "category": "human-only",
        "reason": "A browser's own Web Push subscription; bound to a person's device."
      }
    },
    "api/pwa": {
      "exclude": {
        "category": "public-unauth",
        "reason": "PWA icons served to any browser."
      }
    },
    "api/quotes": {
      "scope": true
    },
    "api/reviews": {
      "exclude": {
        "category": "public-unauth",
        "reason": "The public review-feedback form a customer fills in."
      }
    },
    "api/scheduled-messages": {
      "scope": true
    },
    "api/social": {
      "scope": true
    },
    "api/sub-accounts": {
      "scope": true
    },
    "api/tasks": {
      "scope": true
    },
    "api/u": {
      "exclude": {
        "category": "public-unauth",
        "reason": "Unsubscribe links in sent messages, authenticated by their token."
      }
    },
    "api/v1": {
      "exclude": {
        "category": "internal",
        "reason": "The key-authenticated REST API itself (resources plus /api/v1/tools); agents call it directly, no tool wraps it."
      }
    },
    "api/web-chat": {
      "exclude": {
        "category": "public-unauth",
        "reason": "The embeddable web-chat widget's visitor endpoints."
      }
    },
    "api/webhooks": {
      "exclude": {
        "category": "public-unauth",
        "reason": "Inbound provider webhooks (Meta, Stripe, Paystack, Twilio, Vapi, Webinar1, WhatsApp), authenticated by provider signatures."
      }
    },
    "api/webhooks-out": {
      "exclude": {
        "category": "internal",
        "reason": "QStash-signed outbound-webhook delivery step worker."
      }
    },
    "api/workflows": {
      "scope": true
    },
    "l": {
      "scope": true
    },
    "manifest.webmanifest": {
      "exclude": {
        "category": "public-unauth",
        "reason": "The PWA web manifest, served to any browser."
      }
    },
    "pay": {
      "scope": true
    },
    "report": {
      "scope": true
    },
    "rr": {
      "scope": true
    }
