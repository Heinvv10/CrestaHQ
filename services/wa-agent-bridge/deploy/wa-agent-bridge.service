[Unit]
Description=WhatsApp agent bridge (rails-guarded)
After=network-online.target
Wants=network-online.target

# Bound the restart loop. A failing initial WhatsApp connect exits the process,
# and Restart=on-failure with RestartSec=15 would otherwise retry forever at
# ~4 attempts/minute — "retrying in a loop turns a soft flag into a harder
# block", the exact behaviour the Go code refuses and this file would hand
# back. RestartSec=15 never trips systemd's default 5-in-10s limit, so the
# window has to be widened explicitly: 5 attempts in 10 minutes, then the unit
# enters `failed` and waits for a human.
#
# These keys belong in [Unit], not [Service], on systemd >= 229.
#
# Do NOT "fix" this by deleting Restart= — that loses genuine crash recovery.
# A LoggedOut does not exit the process (it sets the kill switch and keeps
# serving), so it is unaffected by any of this; only the transient-connect
# path is.
StartLimitBurst=5
StartLimitIntervalSec=600

[Service]
Type=simple
User=wabridge
WorkingDirectory=/opt/wa-agent-bridge
EnvironmentFile=/opt/wa-agent-bridge/.env
ExecStart=/opt/wa-agent-bridge/wa-agent-bridge
Restart=on-failure
RestartSec=15
StandardOutput=append:/opt/wa-agent-bridge/bridge.log
StandardError=append:/opt/wa-agent-bridge/bridge.log

# SIGTERM is the clean path: the process stops accepting sends, closes the
# WhatsApp socket, then drains in-flight webhook deliveries. Give it room.
# main.go's shutdownBudget const bounds the first step (HTTP graceful drain,
# which covers an in-flight send) at 35s — chosen to outlast QueueOpts.Timeout
# (30s). The second step, fanout.Wait(), is bounded by the webhook http.Client's
# own 10s timeout. Worst case end to end: 35s + 10s = 45s, so TimeoutStopSec
# must stay above that; 60s leaves 15s of headroom before SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=60

# The bridge holds a WhatsApp session and a token file; nothing else on the box
# needs to read them.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/wa-agent-bridge

[Install]
WantedBy=multi-user.target
