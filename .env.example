# ======================
# Firebase Client SDK
# ======================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ======================
# Firebase Admin SDK
# ======================
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key from your service account JSON (include the -----BEGIN/END----- markers)
FIREBASE_ADMIN_PRIVATE_KEY=

# ======================
# Stripe
# ======================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# --- Client Billing provider (agency -> sub-account) ------------------------
# Paystack is the rail for South African agencies: Stripe will not onboard an
# SA entity for SaaS-mode rebilling. Set the secret key from
# dashboard.paystack.com -> Settings -> API Keys & Webhooks.
# The key alone selects nothing: Client Billing stays on Stripe until
# BILLING_PROVIDER=paystack says otherwise. That is deliberate — the Paystack
# webhook receiver is NOT built yet, so a deployment switched onto this rail
# would take a client's payment and leave their workspace walled.
PAYSTACK_SECRET_KEY=
BILLING_PROVIDER=

# ======================
# App
# ======================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bootstrap admin email — only this email is allowed to claim the admin slot
# on first signup. Set this BEFORE deploying so a stranger can't grab admin
# during the deploy window. After admin is claimed, this var is ignored...
BOOTSTRAP_ADMIN_EMAIL=

# ======================
# In-app guided setup form (OPTIONAL — prerequisites only)
# Powers the optional Agency -> Guided setup screen, where the agency owner
# can type the remaining API keys in-app and have them written to Vercel (and
# your local .env.local) instead of editing env vars by hand. Everything works
# the same if you skip this and set vars manually.
#
# These four are the ONLY vars that must be set the manual way first — the form
# can't set its own credentials. After adding them in Vercel, REDEPLOY ONCE so
# the running build can read them; only then does the enable toggle light up.
#
#   VERCEL_TOKEN           Vercel -> Account Settings -> Tokens -> Create.
#                          Scope to this team/project as tightly as your plan
#                          allows — it can read/write all env + trigger deploys.
#   VERCEL_PROJECT_ID      Vercel -> Project -> Settings -> General (prj_...).
#   VERCEL_DEPLOY_HOOK_URL Vercel -> Project -> Settings -> Git -> Deploy Hooks;
#                          create one on the production branch, copy its URL.
#   VERCEL_TEAM_ID         Vercel -> Team Settings -> General (team_...). Only
#                          if the project is team-owned; leave blank otherwise.
#
# The enable toggle itself lives in Firestore (appConfig/setup.formEnabled), not
# here — so it can be flipped in-app with no redeploy. Leave all four blank to
# keep the VERCEL WRITE path disabled. (In local dev the form can still write
# your .env.local without these — that path needs no Vercel creds.)
# ======================
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_DEPLOY_HOOK_URL=
VERCEL_TEAM_ID=

# ======================
# Cookie Secrets (for next-firebase-auth-edge)
# Generate with: openssl rand -base64 32
# ======================
COOKIE_SECRET_CURRENT=
COOKIE_SECRET_PREVIOUS=

# ======================
# Email (Resend)
# Shared sender — get an API key at https://resend.com and verify your
# sending domain under Domains. EMAIL_FROM must be on a verified domain.
# ======================
RESEND_API_KEY=
EMAIL_FROM="Your Brand <notifications@example.com>"

# ======================
# SMS (Twilio)
# Shared sender — get credentials at https://console.twilio.com. Trial
# accounts can only send to verified numbers and prepend a trial banner.
# ======================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ======================
# Automations / Workflow Recipes (Upstash QStash)
# Get keys at https://console.upstash.com/qstash. The signing keys
# (current + next) verify the inbound POST signature on the step
# executor route; rotate by promoting NEXT to CURRENT.
# QSTASH_URL is the region endpoint shown in the QStash dashboard's
# Quickstart panel — required because the SDK's default doesn't always
# match the token's region.
# Without these, the automation step route returns 503 (graceful fail).
# ======================
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Server-side secret used to HMAC unsubscribe tokens. Generate with:
# openssl rand -base64 32
# Rotating this value invalidates every outstanding unsubscribe link.
AUTOMATIONS_TOKEN_SECRET=

# ======================
# Website builder (gitpage.site)
# Single agency-level API key, shared by every sub-account. Generate at
# https://www.gitpage.site Dashboard -> API Access -> Generate API Key.
# Format: gp_<64 hex chars>. Rotating regenerates and invalidates the
# previous key.
# GITPAGE_API_URL is optional; defaults to https://www.gitpage.site.
# ======================
GITPAGE_API_KEY=
GITPAGE_API_URL=

# ======================
# AI SMS replies (optional)
# Powers the per-sub-account "AI Replies" feature in Settings. When a
# lead texts a sub-account's dedicated Twilio number, an LLM agent
# replies in real time using the configured persona + safety rails.
#
# Get a key at https://openrouter.ai. One key covers every supported
# model — Anthropic Claude, OpenAI GPT, Google Gemini, etc.
#
# Cost: default model (Claude Haiku 4.5) is ~$0.005-0.02 per SMS
# exchange. Per-sub-account override to Opus 4.7 etc. is ~50x more.
#
# Without these vars, the AI Replies settings panel renders but the
# toggle stays inert — incoming SMS only triggers the existing chat
# thread storage, no AI reply fires.
# ======================
OPENROUTER_API_KEY=

# Default OpenRouter model id when no per-sub-account override is set.
# Leave blank to use Claude Haiku 4.5 (recommended cost/quality balance).
# AI_REPLIES_DEFAULT_MODEL=anthropic/claude-haiku-4-5

# Model for the AI Suite in-app assistant (Sidebar -> AI Suite and
# Agency -> AI Suite). Reuses OPENROUTER_API_KEY above. Leave blank to use
# Opus 4.8 (the AI Suite is the premium, reasoning-heavy surface). Without
# OPENROUTER_API_KEY, the AI Suite pages render but the chat returns a 503.
# AI_SUITE_MODEL=anthropic/claude-opus-4-8

# ======================
# Firecrawl (optional — powers the AI Agent website KB)
# When set, the AI Agents -> Overview page exposes a "Refresh KB" button
# that scrapes the sub-account's saved website homepage and stores the
# markdown back on the agent profile. The agent then references it when
# replying to inbound messages.
# Get a key at https://firecrawl.dev -> Dashboard -> API Keys.
# One key per agency deployment — shared across all sub-accounts.
# ======================
FIRECRAWL_API_KEY=

# ======================
# Pexels (optional — stock photos for funnel pages)
# ======================
# When set, the Labs funnel builder can fetch real stock photos: the AI
# drafter fills each image section automatically, and every image field
# gets a "Find" button that searches by keyword.
# Without it, funnels still work — image fields just stay empty and you
# paste your own URLs.
# Free key at https://www.pexels.com/api/ (generous limits, no card).
# Pexels' licence allows commercial use with no attribution required,
# which matters when the photos land on a client's sales page.
# ======================
PEXELS_API_KEY=

# ======================
# Vapi (optional — powers the AI Voice Agent channel)
# Sign up at https://vapi.ai -> Dashboard -> API Keys for the private
# API key. The webhook secret is anything you generate locally and paste
# into the Vapi assistant's "Server URL Secret" field — Vapi sends it
# back as `Authorization: Bearer <secret>` on every webhook to us so we
# can verify the call came from Vapi and not a stranger who guessed our
# webhook URL. Generate with: openssl rand -base64 32
# Without these the AI Agents -> Voice settings page renders but the
# Enable toggle returns 503 with a friendly "Vapi not configured" error.
# ======================
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
# Optional. The public URL Vapi calls back on (LLM turn webhook + end-of-call),
# baked into the assistant on every voice save. Set it to your PRODUCTION URL
# in every environment (prod AND local dev) so provisioning can be tested
# locally without ever repointing the live assistant's webhook at localhost.
# Falls back to NEXT_PUBLIC_APP_URL when unset (fine if you only ever save
# voice settings from production).
VAPI_PUBLIC_BASE_URL=

# ======================
# Meta — Facebook Messenger + Instagram DM inbox (optional, BETA)
# Powers the agency-gated "Facebook + Instagram inbox" beta channels. Create a
# Meta app at https://developers.facebook.com (Business type), add Messenger +
# Instagram, and complete App Review for pages_messaging +
# instagram_manage_messages before it works for non-testers. Register the
# webhook callback (https://YOUR-DOMAIN/api/webhooks/meta) with the verify
# token below, and add https://YOUR-DOMAIN/api/meta/callback as a valid OAuth
# redirect URI — ONE entry for the whole deployment, the same for every
# sub-account (the connecting sub-account is carried in the signed OAuth
# state, so no per-client registration is needed). Without these, the beta
# gate + settings card
# still render but the Connect button reports "not configured on this
# deployment". OAuth `state` is signed with AUTOMATIONS_TOKEN_SECRET (reused).
# ======================
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Optional: secret of a separate WhatsApp Cloud Meta app. The WhatsApp Cloud
# webhook accepts this app's signature as well as META_APP_SECRET's.
WHATSAPP_APP_SECRET=
# Optional: Graph API version for every WhatsApp Cloud call, including the
# inbound media download. Defaults to v23.0.
WHATSAPP_GRAPH_VERSION=

# ======================
# Google Business Profile (optional)
# OAuth client for connecting a sub-account's Google Business Profile.
# Create a Web application OAuth client at console.cloud.google.com ->
# APIs & Services -> Credentials, grant the
# https://www.googleapis.com/auth/business.manage scope on the consent screen,
# and add https://YOUR-DOMAIN/api/google/callback as an authorised redirect
# URI - ONE entry for the whole deployment, the same for every sub-account
# (the connecting sub-account is carried in the signed OAuth state, so no
# per-client registration is needed). Google matches the URI EXACTLY, so it
# must equal NEXT_PUBLIC_APP_URL + /api/google/callback byte for byte.
# Without these the settings card still renders but Connect reports "not
# configured on this deployment". OAuth `state` is signed with
# AUTOMATIONS_TOKEN_SECRET (reused).
# ======================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ======================
# Crisp Chat (optional)
# Live-chat widget loaded on every page. Get a Website ID at
# https://app.crisp.chat -> Settings -> Website Settings -> Setup
# Instructions. Leave blank to disable the widget entirely.
# ======================
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# ======================
# Meta Pixel (optional)
# Site-wide Meta (Facebook) Pixel. When set, every page loads the pixel
# and fires PageView automatically; hosted form pages (/f/[id]) also
# fire a `Lead` event on successful submission. Find your Pixel ID at
# Meta Events Manager -> Data Sources. Leave blank to disable.
# ======================
NEXT_PUBLIC_META_PIXEL_ID=

# ======================
# Google Tag Manager (optional)
# Site-wide GTM container. Useful as the escape hatch for any tracking
# tag Meta Pixel doesn't already cover (LinkedIn, TikTok, Hotjar, custom
# server-side events via gtag, etc). Format: GTM-XXXXXXX.
# ======================
NEXT_PUBLIC_GTM_ID=

# ======================
# Leads map (Mapbox)
# Drives the "Where your leads are" map on the sub-account dashboard.
# Free tier: 50,000 map loads / month.
#   1. Sign up at https://account.mapbox.com
#   2. Account -> Tokens -> Create a token (default public scopes are fine)
#   3. Paste the pk.* token below
# Without this, the dashboard renders a "Mapbox not configured" card
# instead of the map — everything else still works.
# ======================
NEXT_PUBLIC_MAPBOX_TOKEN=

# ======================
# Get Leads prospecting (Google Places API (New) - optional)
# Business search for Get Leads and Prospecting. Server-only; restrict the
# key to places.googleapis.com. One agency-level key shared by every
# sub-account; each sub-account still needs the Get Leads gate switched on.
#   Google Cloud console -> enable "Places API (New)" -> Credentials
# Free up to 1,000 Text Search calls/month; set a daily SearchText quota.
# Without it, Get Leads searches return "not configured".
# ======================
GOOGLE_PLACES_API_KEY=

# ======================
# Push notifications (PWA - optional)
# Powers phone push alerts for new leads, inbound messages, bookings,
# and missed calls once the app is installed to a home screen.
#   1. Generate a key pair once:  npx web-push generate-vapid-keys
#   2. Paste the public key below (NEXT_PUBLIC_* = build-time inlined,
#      redeploy after setting) and the private key next to it.
# Without these, install still works - notifications just stay off and
# the /me/settings Notifications card says "not configured".
# ======================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ======================
# services/qcontact-import (Velocity Fibre only — NOT read by the app)
# Pulls new-installation cases from Fibertime QContact into the Velocity
# sub-account. See services/qcontact-import/README.md. Leave blank on
# every other install.
# ======================
QCONTACT_IMPORT_EMAIL=
QCONTACT_IMPORT_PASSWORD=
LEADSTACK_API_URL=
LEADSTACK_API_KEY=
# Optional: opens a deal in this pipeline after each upsert. Unset = no deal calls.
QCONTACT_DEAL_PIPELINE_ID=
QCONTACT_DEAL_STAGE=
QCONTACT_DEAL_OWNER_UID=
# Optional: "1" to also sync QContact case status onto the deal's stage every
# run. Unset or "0" (default) = no stage syncing at all.
QCONTACT_SYNC_STAGES=
