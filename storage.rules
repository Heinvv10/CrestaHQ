rules_version = '2';

// Firebase Storage rules. The only writer surface today is the Community
// feature's group cover/logo uploads. Community group images are PUBLIC (the
// About page at /c/* is public), so reads are open; writes require a signed-in
// Firebase user (staff — community members are NOT Firebase users, so they
// can't write here) plus an image content-type + 5 MB size cap.
//
// Deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    // Community group cover/logo images.
    match /community/{subAccountId}/{groupId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // WhatsApp media (inbound photos, voice notes, documents). Written and
    // read only by the Admin SDK, which bypasses rules; reads reach operators
    // through /api/comms/whatsapp/media/[contactId]/[messageId], which
    // authorises the caller. The catch-all below would already deny this, but
    // the one path holding customers' photos states its own rule so a future
    // edit to the catch-all cannot silently open it.
    match /whatsapp-media/{allPaths=**} {
      allow read, write: if false;
    }

    // Default deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
